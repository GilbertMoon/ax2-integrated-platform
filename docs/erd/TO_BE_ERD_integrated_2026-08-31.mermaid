}
CONCEPTS {
    int id PK
    string name
    string description
}
TASKS {
    uuid id PK
    int concept_id FK
    string type
    string difficulty
    text template_code
    text test_cases
    boolean is_active
}
USER_PROFICIENCY {
    uuid id PK
    bigint user_id FK
    int concept_id FK
    int proficiency_level
    datetime updated_at
}
TASK_ATTEMPTS {
    uuid id PK
    bigint user_id FK
    uuid task_id FK
    text submitted_code
    string status
    boolean is_correct
    text feedback_message
    boolean used_hint
