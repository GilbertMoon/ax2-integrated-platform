ATTENDANCE_RECORD ||--o{ FACE_RECOGNITION_LOG : "인식 로그"
FACE_PROFILE ||--o{ FACE_RECOGNITION_LOG : "인식 대상"

FACE_PROFILE {
    bigint id PK
    bigint user_id FK
    string status
    datetime created_at
    datetime updated_at
}
FACE_IMAGE {
    bigint id PK
    bigint face_profile_id FK
    string image_url
    string image_hash
    boolean is_primary
    datetime created_at
}
ATTENDANCE_RECORD {
    bigint id PK
    bigint user_id FK
    date attendance_date
    datetime check_in_at
    datetime check_out_at
    string status
    string source
    datetime created_at
}
FACE_RECOGNITION_LOG {
    bigint id PK
    bigint user_id FK
    bigint face_profile_id FK
    bigint attendance_record_id FK
    datetime recognized_at
    decimal confidence
    string result
}

%% ==========================================================
%% 최종 점수 집계 / 개인-팀 무결성
%% ==========================================================

results_calculationrun ||--o{ results_scoreinput : "입력"
results_scoreinput }o--o| rounds_roundparticipant : "개인 대상"
results_scoreinput }o--o| teams_team : "팀 대상"
SUBMISSION ||..o{ results_scoreinput : "점수 push"
PRD_Member_Evaluations ||..o{ results_scoreinput : "점수 push"

results_scoreinput {
    bigint id PK
    bigint calculation_run_id FK
    bigint participant_id FK
    bigint team_id FK
    varchar source_type
    bigint source_id
    decimal raw_score
    decimal weight
    varchar idempotency_key UK
    datetime pushed_at
    datetime created_at
}

%% ==========================================================
%% 무결성 규칙
%% 1) CG_USERS.id = accounts_user.id : bigint PK/FK, username 중복 없음
%% 2) Team = 평가회차별 Team. teams_team.round_id 필수
%% 3) PRDs.round_id -> rounds_evaluationround.id
%% 4) results_evaluationresult: TEAM => team_id만 입력
%% 5) results_evaluationresult: INDIVIDUAL => participant_id만 입력
%% 6) results_scoreinput: participant_id XOR team_id
%% 7) SUBMISSION: student_id XOR team_id
%% 8) EVALUATION.score = 공식 Source of Truth, SUBMISSION.final_score = 캐시
%% 9) 1조 ATTENDANCES와 4조 ATTENDANCE_RECORD는 목적상 분리
%% 10) FK 타입은 Core accounts_user/rounds/teams 기준으로 bigint 통일
