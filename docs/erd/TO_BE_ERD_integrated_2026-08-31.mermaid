CG_USERS ||--o{ INVENTORIES : "owns"
CG_USERS ||--o{ USER_CATS : "adopts"
teams_team ||--o{ ROOM_PARTICIPANTS : "배틀 참여 팀"
CONCEPTS ||--o{ TASKS : "categorizes"
CONCEPTS ||--o{ USER_PROFICIENCY : "measured_by"
TASKS ||--o{ TASK_ATTEMPTS : "recorded_in"
TASKS ||--o{ ROOM_TASKS : "selected_for"
TASKS ||--o{ RANK_CHALLENGE_TASKS : "includes"
ROOMS ||--o{ ROOM_PARTICIPANTS : "has_participants"
ROOMS ||--o{ ROOM_TASKS : "assigns"
RANKING_GROUPS ||--o{ RANKING_PARTICIPANTS : "includes"
RANK_CHALLENGES ||--o{ RANK_CHALLENGE_TASKS : "consists_of"
ITEMS ||--o{ INVENTORIES : "stored_in"
