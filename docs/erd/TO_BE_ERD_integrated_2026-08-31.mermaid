}
CATS {
    int id PK
    string name
    string persona
    string rarity
}
USER_CATS {
    uuid id PK
    bigint user_id FK
    int cat_id FK
    int level
}
CAT_MEMORIES {
    uuid id PK
    uuid user_cat_id FK
    text context_summary
    datetime created_at
}

