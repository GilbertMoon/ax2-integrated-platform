erDiagram

%% ==========================================================
%% 통합 TO-BE ERD v1
%% Mermaid/GitHub 렌더링 호환: entity attribute는 한 줄에 하나씩 작성
%% ==========================================================

accounts_user ||--o{ account_emailaddress : "보유"
accounts_user ||--o{ rounds_roundparticipant : "참여"
accounts_user ||--o{ rounds_evaluationround : "생성"
accounts_user ||--o{ notices_notice : "생성"
accounts_user ||--o{ notifications_notification : "수신"
accounts_user ||--o{ audit_auditevent : "행위자"
rounds_evaluationround ||--o{ rounds_roundparticipant : "포함"
rounds_evaluationround ||--o{ teams_team : "포함 - 회차 종속 Team"
rounds_evaluationround ||--o{ results_calculationrun : "채점 실행"
rounds_roundparticipant |o--o| teams_teammembership : "소속"
teams_team ||--o{ teams_teammembership : "포함"
rounds_roundparticipant ||--o{ reviews_reviewsubmission : "평가자"
rounds_roundparticipant ||--o{ reviews_reviewsubmission : "대상 참가자"
teams_team ||--o{ reviews_reviewsubmission : "대상 팀"
reviews_reviewsubmission ||--o{ reviews_reviewanswer : "답변"
rounds_templatequestion ||--o{ reviews_reviewanswer : "문항"
results_calculationrun ||--o{ results_evaluationresult : "결과 산출"
teams_team ||--o{ results_evaluationresult : "팀 결과"
rounds_roundparticipant ||--o{ results_evaluationresult : "개인 결과"

accounts_user {
    bigint id PK
    varchar email UK
    varchar password
    varchar role
    varchar approval_status
}
account_emailaddress {
    bigint id PK
    bigint user_id FK
    varchar email
    boolean verified
    boolean primary
}
rounds_evaluationround {
    bigint id PK
    bigint created_by FK
    varchar title
    varchar status
    decimal team_score_weight
    decimal personal_score_weight
}
rounds_roundparticipant {
    bigint id PK
    bigint user_id FK
    bigint round_id FK
    varchar student_number_snapshot
    varchar display_name_snapshot
}
rounds_templatequestion {
    bigint id PK
    text content
}
teams_team {
    bigint id PK
    bigint round_id FK
    int team_number
    varchar name
}
teams_teammembership {
    bigint id PK
    bigint team_id FK
    bigint participant_id FK
}
reviews_reviewsubmission {
    bigint id PK
    varchar review_type
    bigint evaluator_id FK
    bigint target_team_id FK
    bigint target_participant_id FK
}
reviews_reviewanswer {
    bigint id PK
    bigint submission_id FK
    bigint question_id FK
    int rating_value
}
results_calculationrun {
    bigint id PK
    bigint round_id FK
    varchar status
    boolean is_active
}
results_evaluationresult {
    bigint id PK
    bigint calculation_run_id FK
    bigint team_id FK
    bigint participant_id FK
    varchar result_type
    decimal final_score_raw
}
notices_notice {
    bigint id PK
    bigint created_by_id FK
    boolean is_published
}
notifications_notification {
    bigint id PK
    bigint recipient_id FK
    varchar category
}
audit_auditevent {
    bigint id PK
    bigint round_id FK
    bigint actor_id FK
    varchar action
}

