PRDs ||--o{ AI_Chat_Histories : "AI 채팅"
Templates { bigint template_id PK; string type_name }
Template_Sections { bigint template_section_id PK; bigint template_id FK; string title; string guidance; int order_num }
Template_Questions { bigint template_question_id PK; bigint template_section_id FK; string title; int order_num }
PRDs { bigint prd_id PK; bigint template_id FK; bigint user_id FK; bigint round_id FK "rounds_evaluationround"; bigint team_id FK; string title; string status; date deadline; boolean is_deleted; datetime created_at; datetime updated_at }
PRD_Permissions { bigint permission_id PK; bigint prd_id FK; bigint target_user_id FK; string role; datetime created_at }
PRD_Sections { bigint section_id PK; bigint prd_id FK; string title; string guidance; boolean is_completed; boolean is_held; boolean is_deleted; int order_num }
PRD_Questions { bigint question_id PK; bigint section_id FK; string title; text answer; boolean is_held; boolean is_deleted; int order_num }
PRD_Comments { bigint comment_id PK; bigint prd_id FK; bigint section_id FK; bigint user_id FK; text content; datetime created_at }
Brainstorm_Boards { bigint board_id PK; bigint prd_id FK }
Brainstorm_Categories { bigint category_id PK; bigint board_id FK; string title }
Post_its { bigint post_it_id PK; bigint board_id FK; bigint category_id FK; bigint user_id FK; text content; string color; float pos_x; float pos_y; string status }
AI_Usage_Logs { bigint log_id PK; bigint user_id FK; bigint prd_id FK; string feature_type; int total_tokens; datetime created_at }
AI_Prompts { bigint prompt_id PK; string feature_type; text system_instruction; string version; boolean is_active }
PRD_Member_Evaluations { bigint evaluation_id PK; bigint prd_id FK; bigint user_id FK; int total_post_its; int accepted_post_its; int total_comments; float reflection_rate; int total_score; text ai_comment; datetime created_at }
PRD_Edit_Histories { bigint history_id PK; bigint section_id FK; string edit_type; text before_content; text after_content; datetime created_at }
AI_Chat_Histories { bigint chat_id PK; bigint prd_id FK; bigint section_id FK; bigint user_id FK; json chat_data; datetime created_at; date expires_at }

%% 4조 실제 근태 / 얼굴인식: 1조 ATTENDANCES와 목적이 달라 분리
accounts_user ||--o| FACE_PROFILE : "얼굴인식 프로필"
FACE_PROFILE ||--o{ FACE_IMAGE : "등록 이미지"
accounts_user ||--o{ ATTENDANCE_RECORD : "실제 근태"
ATTENDANCE_RECORD ||--o{ FACE_RECOGNITION_LOG : "인식 로그"
FACE_PROFILE ||--o{ FACE_RECOGNITION_LOG : "인식 대상"
FACE_PROFILE { bigint id PK; bigint user_id FK; string status; datetime created_at; datetime updated_at }
FACE_IMAGE { bigint id PK; bigint face_profile_id FK; string image_url; string image_hash; boolean is_primary; datetime created_at }
ATTENDANCE_RECORD { bigint id PK; bigint user_id FK; date attendance_date; datetime check_in_at; datetime check_out_at; string status; string source; datetime created_at }
FACE_RECOGNITION_LOG { bigint id PK; bigint user_id FK; bigint face_profile_id FK; bigint attendance_record_id FK; datetime recognized_at; decimal confidence; string result }

%% 개인/팀 Target 무결성
%% results_evaluationresult: TEAM => team_id만 / INDIVIDUAL => participant_id만
%% results_scoreinput: participant_id XOR team_id
%% SUBMISSION: assignment.is_team=false => student_id만 / true => team_id만
results_calculationrun ||--o{ results_scoreinput : "입력값 수집"
results_scoreinput }o--o| rounds_roundparticipant : "개인 대상"
results_scoreinput }o--o| teams_team : "팀 대상"
SUBMISSION ||..o{ results_scoreinput : "확정 시 push"
PRD_Member_Evaluations ||..o{ results_scoreinput : "확정 시 push"
reviews_reviewanswer ||..o{ results_scoreinput : "논리적 참조"
results_scoreinput { bigint id PK; bigint calculation_run_id FK; bigint participant_id FK; bigint team_id FK; varchar source_type; bigint source_id; decimal raw_score; decimal weight; varchar idempotency_key UK; datetime pushed_at; datetime created_at; string target_integrity_rule "participant_id XOR team_id" }
