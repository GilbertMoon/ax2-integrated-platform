PRDs ||--o| Brainstorm_Boards : "1:1 종속"
Brainstorm_Boards ||--o{ Brainstorm_Categories : "분할 칸"
Brainstorm_Boards ||--o{ Post_its : "포스트잇"
Brainstorm_Categories ||--o{ Post_its : "분류"
PRDs ||--o{ AI_Usage_Logs : "호출된 PRD"
