SUBMISSION ||--o| EVALUATION : "튜터 공식 평가"

LECTURE {
    int id PK
    string title
    datetime created_at
}
LESSON {
    int id PK
    int lecture_id FK
    string title
    date lesson_date
    string blog_link
    string video_url
    datetime created_at
}
LESSON_MATERIAL {
    int id PK
    int lesson_id FK
    string kind
    string file_url
    string link_url
    string title
}
ASSIGNMENT {
    int id PK
    string title
    string description
    datetime due_at
    boolean is_required
    boolean allow_late
    boolean is_team
    bigint created_by FK
    datetime created_at
    datetime updated_at
    datetime deleted_at
}
SUBMISSION {
    int id PK
    int assignment_id FK
    bigint student_id FK
    bigint team_id FK
    string target_rule
    string description
    datetime submitted_at
    boolean is_locked
    int final_score
}
SUBMISSION_FILE {
    int id PK
    int submission_id FK
    string kind
    string file_url
    string file_name
    int file_size
}
AI_EVALUATION {
    int id PK
    int submission_id FK
    int score
    string comment
    datetime updated_at
}
EVALUATION {
    int id PK
    int submission_id FK
    bigint evaluated_by FK
    int score
    string feedback
    datetime created_at
    datetime updated_at
}

