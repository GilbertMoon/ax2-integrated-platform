CG_USERS {
    bigint id PK,FK "accounts_user.id와 동일 (1:1)"
    int balance
    int mileage
    int house_level
    int wallpaper_item_id FK
    int floor_item_id FK
    datetime created_at
}
ATTENDANCES { uuid id PK; bigint user_id FK; date check_in_date; int streak_count }
CONCEPTS { int id PK; string name; string description }
TASKS { uuid id PK; int concept_id FK; string type; string difficulty; text template_code; text test_cases; boolean is_active }
USER_PROFICIENCY { uuid id PK; bigint user_id FK; int concept_id FK; int proficiency_level; datetime updated_at }
TASK_ATTEMPTS { uuid id PK; bigint user_id FK; uuid task_id FK; text submitted_code; string status; boolean is_correct; text feedback_message; boolean used_hint; datetime attempted_at }
ROOMS { uuid id PK; bigint host_user_id FK; string title; string status; int max_participants; datetime created_at }
ROOM_PARTICIPANTS { uuid id PK; uuid room_id FK; bigint user_id FK; bigint team_id FK; int current_score; boolean is_ready; datetime joined_at }
ROOM_TASKS { uuid id PK; uuid room_id FK; uuid task_id FK; int task_order }
RANKING_GROUPS { uuid id PK; string name; bigint owner_user_id FK }
RANKING_PARTICIPANTS { uuid id PK; uuid group_id FK; bigint user_id FK; int current_rank_score }
RANK_CHALLENGES { uuid id PK; bigint user_id FK; uuid group_id FK; string status; datetime started_at; datetime expires_at }
RANK_CHALLENGE_TASKS { uuid id PK; uuid challenge_id FK; uuid task_id FK; boolean is_passed; text saved_code; int task_order }
ITEMS { int id PK; string category; string name; int price; string image_url }
INVENTORIES { uuid id PK; uuid user_id FK; int item_id FK; int quantity }
HOUSE { bigint id PK; bigint user_id FK; string name; datetime created_at; datetime updated_at }
PLACED_OBJECTS { uuid id PK; uuid house_id FK; int item_id FK; jsonb position_data }
CATS { int id PK; string name; string persona; string rarity }
USER_CATS { uuid id PK; bigint user_id FK; int cat_id FK; int level }
CAT_MEMORIES { uuid id PK; uuid user_cat_id FK; text context_summary; datetime created_at }

LECTURE ||--o{ LESSON : "포함"
LESSON ||--o{ LESSON_MATERIAL : "교안 보유"
accounts_user ||--o{ ASSIGNMENT : "생성 (튜터)"
accounts_user ||--o{ SUBMISSION : "제출 (개인 과제)"
teams_team ||--o{ SUBMISSION : "제출 (팀 과제, 팀장만)"
accounts_user ||--o{ TODO : "소유"
ASSIGNMENT ||--o{ SUBMISSION : "포함"
SUBMISSION ||--o{ SUBMISSION_FILE : "첨부"
SUBMISSION ||--o| AI_EVALUATION : "AI 1차 평가"
SUBMISSION ||--o| EVALUATION : "튜터 공식 평가"
LECTURE { int id PK; string title; datetime created_at }
LESSON { int id PK; int lecture_id FK; string title; date lesson_date; string blog_link; string video_url; datetime created_at }
LESSON_MATERIAL { int id PK; int lesson_id FK; string kind; string file_url; string link_url; string title }
ASSIGNMENT { int id PK; string title; string description; datetime due_at; boolean is_required; boolean allow_late; boolean is_team; int created_by FK; datetime created_at; datetime updated_at; datetime deleted_at }
SUBMISSION { int id PK; int assignment_id FK; int student_id FK; int team_id FK; string target_integrity_rule "student_id XOR team_id"; string description; datetime submitted_at; boolean is_locked; int final_score "EVALUATION.score 캐시값" }
SUBMISSION_FILE { int id PK; int submission_id FK; string kind; string file_url; string file_name; int file_size }
AI_EVALUATION { int id PK; int submission_id FK; int score; string comment; datetime updated_at }
EVALUATION { int id PK; int submission_id FK; bigint evaluated_by FK; int score "공식 Source of Truth"; string feedback; datetime created_at; datetime updated_at }
TODO { int id PK; int student_id FK; string content; boolean is_done; datetime created_at }

