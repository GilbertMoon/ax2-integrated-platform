    PRDs ||--o{ AI_Chat_Histories : chats

    Templates {
        bigint template_id PK
        string type_name
    }
    Template_Sections {
        bigint template_section_id PK
        bigint template_id FK
        string title
        string guidance
        int order_num
    }
    Template_Questions {
        bigint template_question_id PK
        bigint template_section_id FK
        string title
        int order_num
    }
    PRDs {
        bigint prd_id PK
        bigint template_id FK
        bigint user_id FK "accounts_user.id"
        bigint round_id FK "rounds_evaluationround.id"
        bigint team_id FK "teams_team.id"
        string title
        string status
        date deadline
        boolean is_deleted
        datetime created_at
        datetime updated_at
    }
    PRD_Permissions {
        bigint permission_id PK
        bigint prd_id FK
        bigint target_user_id FK "accounts_user.id"
        string role
        datetime created_at
    }
    PRD_Sections {
        bigint section_id PK
        bigint prd_id FK
        string title
        string guidance
        boolean is_completed
        boolean is_held
        boolean is_deleted
        int order_num
    }
    PRD_Questions {
        bigint question_id PK
        bigint section_id FK
        string title
        text answer
        boolean is_held
        boolean is_deleted
        int order_num
    }
    PRD_Comments {
        bigint comment_id PK
        bigint prd_id FK
        bigint section_id FK
        bigint user_id FK "accounts_user.id"
        text content
        datetime created_at
    }
    Brainstorm_Boards {
        bigint board_id PK
        bigint prd_id FK
    }
    Brainstorm_Categories {
        bigint category_id PK
        bigint board_id FK
        string title
    }
    Post_its {
        bigint post_it_id PK
        bigint board_id FK
        bigint category_id FK
        bigint user_id FK "accounts_user.id"
        text content
        string color
        float pos_x
        float pos_y
        string status
    }
    AI_Usage_Logs {
        bigint log_id PK
        bigint user_id FK "accounts_user.id"
        bigint prd_id FK
        string feature_type
        int total_tokens
        datetime created_at
    }
    AI_Chat_Histories {
        bigint chat_id PK
        bigint prd_id FK
        bigint section_id FK
        bigint user_id FK "accounts_user.id"
        json chat_data
        datetime created_at
        date expires_at
    }
    PRD_Member_Evaluations {
        bigint evaluation_id PK
        bigint prd_id FK
        bigint user_id FK "accounts_user.id"
        int total_post_its
        int accepted_post_its
        int total_comments
        float reflection_rate
        int total_score
        text ai_comment
        datetime created_at
    }
    PRD_Edit_Histories {
        bigint history_id PK
        bigint section_id FK
        string edit_type
        text before_content
        text after_content
        datetime created_at
    }

    %% ==========================================================
    %% 4조 - 실제 근태 / 얼굴인식
    %% 반드시 accounts_user.id를 사용자 식별 기준으로 사용
    %% Round/Team 이력이 필요한 경우에만 participant를 연결
    %% ==========================================================
    accounts_user ||--o{ ATTENDANCE_RECORDS : actual_attendance
    accounts_user ||--o{ STUDENT_FACE_PROFILES : face_profile
    ATTENDANCE_RECORDS ||--o{ FACE_RECOGNITION_LOGS : recognition
    STUDENT_FACE_PROFILES ||--o{ FACE_RECOGNITION_LOGS : matched_profile
    STUDENT_FACE_PROFILES ||--o{ FACE_IMAGES : stores
    rounds_roundparticipant |o--o{ ATTENDANCE_RECORDS : optional_round_history
    rounds_roundparticipant |o--o{ STUDENT_FACE_PROFILES : optional_round_history

    ATTENDANCE_RECORDS {
        bigint id PK
        bigint user_id FK "accounts_user.id"
        bigint participant_id FK "optional: rounds_roundparticipant.id"
        date attendance_date
        datetime check_in_at
        datetime check_out_at
        varchar status
    }
    STUDENT_FACE_PROFILES {
        bigint id PK
        bigint user_id FK "accounts_user.id"
        bigint participant_id FK "optional: rounds_roundparticipant.id"
        varchar profile_status
        datetime registered_at
    }
    FACE_IMAGES {
        bigint id PK
        bigint face_profile_id FK
        varchar image_path
        datetime captured_at
    }
    FACE_RECOGNITION_LOGS {
        bigint id PK
        bigint attendance_id FK
        bigint face_profile_id FK
        bigint predicted_user_id FK "accounts_user.id"
        decimal confidence
        boolean recognition_success
        boolean admin_verified
        bigint verified_user_id FK "accounts_user.id"
        bigint verified_by FK "accounts_user.id"
        datetime verified_at
        datetime recognized_at
    }

    %% ==========================================================
    %% 최종 점수 집계
    %% ==========================================================
    results_calculationrun ||--o{ results_scoreinput : inputs
    rounds_roundparticipant |o--o{ results_scoreinput : individual_target
    teams_team |o--o{ results_scoreinput : team_target

    results_calculationrun {
        bigint id PK
        bigint round_id FK
        varchar status
        boolean is_active
    }
    results_scoreinput {
        bigint id PK
        bigint calculation_run_id FK
        bigint participant_id FK
        bigint team_id FK
        varchar source_type
        bigint source_id
        decimal raw_score
        decimal weight
        varchar idempotency_key UK
        datetime pushed_at
        datetime created_at
    }

    %% ==========================================================
    %% 설계 원칙
    %% ==========================================================
    %% 1. accounts_user.id = 사용자/학생 공통 Master ID
    %% 2. rounds_roundparticipant.id = 특정 평가 Round의 참가 이력
    %% 3. 근태/얼굴인식 = accounts_user.id 기준
    %% 4. Round/Team 이력이 필요한 기능만 rounds_roundparticipant 참조
    %% 5. 1조 ATTENDANCES = 학습 출석/streak
    %% 6. 4조 ATTENDANCE_RECORDS = 실제 근태/얼굴인식 출결
    %% 7. User와 Student가 충돌/중복되는 경우 accounts_user를 공통 기준으로 사용
    %% 8. 각 조의 고유 Domain은 유지하고 필요한 Core만 FK로 연결
