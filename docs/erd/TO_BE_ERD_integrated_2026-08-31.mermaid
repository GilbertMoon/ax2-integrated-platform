erDiagram

%% ==========================================================
%% 0. CORE (AX 평가 시스템 - 전체 구조)
%% 8개 앱: accounts, rounds, teams, reviews, results, notifications, audit, notices
%% ==========================================================
accounts_user ||--o{ account_emailaddress : "보유"
accounts_user ||--o{ rounds_roundparticipant : "참여 (user)"
accounts_user ||--o{ rounds_evaluationround : "생성 (created_by)"
accounts_user ||--o{ notices_notice : "생성 (created_by)"
accounts_user ||--o{ notifications_notification : "수신 (recipient)"
accounts_user ||--o{ audit_auditevent : "행위자 (actor)"

rounds_evaluationround ||--o{ rounds_roundparticipant : "포함 (round)"
rounds_evaluationround ||--o{ teams_team : "포함 (round) — Team은 회차 종속"
rounds_evaluationround ||--o{ results_calculationrun : "채점 실행"
rounds_evaluationround ||--o{ audit_auditevent : "감사 로그"

rounds_roundparticipant |o--o| teams_teammembership : "소속 (1:0..1)"
teams_team ||--o{ teams_teammembership : "포함"

rounds_roundparticipant ||--o{ reviews_reviewsubmission : "평가자 (evaluator)"
rounds_roundparticipant ||--o{ reviews_reviewsubmission : "대상 참가자 (target_participant)"
teams_team ||--o{ reviews_reviewsubmission : "대상 팀 (target_team)"
reviews_reviewsubmission ||--o{ reviews_reviewanswer : "답변 포함"
rounds_templatequestion ||--o{ reviews_reviewanswer : "문항 참조"

results_calculationrun ||--o{ results_evaluationresult : "결과 산출"
teams_team ||--o{ results_evaluationresult : "팀 결과"
rounds_roundparticipant ||--o{ results_evaluationresult : "개인 결과"

accounts_user {
    bigint id PK
    varchar email UK
    varchar password
    varchar role "student/tutor/admin"
    varchar approval_status
}

account_emailaddress {
    bigint id PK
    bigint user_id FK
    varchar email
    boolean verified
    boolean primary
}

rounds_evaluationround {
    bigint id PK
    bigint created_by FK "accounts_user"
    varchar title
    varchar status "DRAFT/IN_PROGRESS/COMPLETED"
    decimal team_score_weight "%"
    decimal personal_score_weight "%"
}

rounds_roundparticipant {
    bigint id PK
    bigint user_id FK
    bigint round_id FK "rounds_evaluationround"
    varchar student_number_snapshot
    varchar display_name_snapshot
}

rounds_templatequestion {
    bigint id PK
    text content
}

teams_team {
    bigint id PK
    bigint round_id FK "rounds_evaluationround"
    int team_number
    varchar name
}

teams_teammembership {
    bigint id PK
    bigint team_id FK
    bigint participant_id "FK_UQ, rounds_roundparticipant"
}

reviews_reviewsubmission {
    bigint id PK
    varchar review_type "TEAM/PEER"
    bigint evaluator_id FK "rounds_roundparticipant"
    bigint target_team_id FK "teams_team"
    bigint target_participant_id FK "rounds_roundparticipant"
}

reviews_reviewanswer {
    bigint id PK
    bigint submission_id FK "reviews_reviewsubmission"
    bigint question_id FK "rounds_templatequestion"
    int rating_value "1~5"
}

results_calculationrun {
    bigint id PK
    bigint round_id FK "rounds_evaluationround"
    varchar status
    boolean is_active
}

results_evaluationresult {
    bigint id PK
    bigint calculation_run_id FK "results_calculationrun"
    bigint team_id FK "teams_team, TEAM일 때 필수"
    bigint participant_id FK "rounds_roundparticipant, INDIVIDUAL일 때 필수"
    varchar result_type "TEAM/INDIVIDUAL"
    string target_integrity_rule "TEAM이면 team_id만, INDIVIDUAL이면 participant_id만 입력"
    decimal final_score_raw
}

notices_notice {
    bigint id PK
    bigint created_by_id FK "accounts_user"
    boolean is_published
}

notifications_notification {
    bigint id PK
    bigint recipient_id FK "accounts_user"
    varchar category
}

audit_auditevent {
    bigint id PK
    bigint round_id FK "rounds_evaluationround"
    bigint actor_id FK "accounts_user"
    varchar action
}

%% 통합 Team Domain 결정: A안 — teams_team은 평가회차(round)별 팀
%% 1/2/3조에서 teams_team을 참조할 때 해당 round context가 전제됨.

accounts_user ||--|| CG_USERS : "1:1 프로필 확장"
CG_USERS ||--o{ ATTENDANCES : "checks_in"
CG_USERS ||--o{ TASK_ATTEMPTS : "attempts"
