    %% ==========================================================
    Templates ||--|{ Template_Sections : contains
    Template_Sections ||--|{ Template_Questions : contains
    Templates ||--o{ PRDs : copied_to
    accounts_user ||--o{ PRDs : owns
    rounds_roundparticipant ||--o{ PRDs : round_context
    teams_team ||--o{ PRDs : team_context
    accounts_user ||--o{ PRD_Permissions : receives
    accounts_user ||--o{ PRD_Comments : writes
    accounts_user ||--o{ Post_its : writes
    accounts_user ||--o{ AI_Usage_Logs : calls
    accounts_user ||--o{ AI_Chat_Histories : chats
    accounts_user ||--o{ PRD_Member_Evaluations : evaluated
    PRDs ||--|{ PRD_Sections : contains
    PRD_Sections ||--|{ PRD_Questions : contains
    PRDs ||--o{ PRD_Permissions : permissions
    PRDs ||--o{ PRD_Comments : comments
    PRD_Sections ||--o{ PRD_Comments : section_comments
    PRDs ||--o| Brainstorm_Boards : has
    Brainstorm_Boards ||--o{ Brainstorm_Categories : categories
    Brainstorm_Boards ||--o{ Post_its : contains
    Brainstorm_Categories ||--o{ Post_its : classifies
    PRDs ||--o{ AI_Usage_Logs : usage
    PRDs ||--o{ PRD_Member_Evaluations : member_scores
