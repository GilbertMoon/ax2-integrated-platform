```mermaid
erDiagram
    %% ==========================================================
    %% CORE — 공통 사용자 / Round / Team
    %% ==========================================================
    %% 결정사항:
    %% accounts_user.id = 사용자/학생 공통 Master ID
    %% rounds_roundparticipant.id = 특정 평가 Round의 참가 이력
    %% 근태/얼굴인식 = accounts_user.id 기준
    %% Round/Team 이력이 필요한 기능만 rounds_roundparticipant 참조

    accounts_user ||--o{ rounds_roundparticipant : participates
    accounts_user ||--o{ rounds_evaluationround : creates
    rounds_evaluationround ||--o{ rounds_roundparticipant : contains
    rounds_evaluationround ||--o{ teams_team : contains
    teams_team ||--o{ teams_teammembership : has
    rounds_roundparticipant |o--o| teams_teammembership : belongs_to
    accounts_user ||--o{ notices_notice : creates
    accounts_user ||--o{ notifications_notification : receives
    accounts_user ||--o{ audit_auditevent : acts
    rounds_evaluationround ||--o{ results_calculationrun : calculates

    accounts_user {
        bigint id PK "공통 Master ID"
        varchar email UK
        varchar password
        varchar role
        varchar approval_status
    }
    rounds_evaluationround {
        bigint id PK
        bigint created_by FK
        varchar title
        varchar status
        decimal team_score_weight
        decimal personal_score_weight
    }
    rounds_roundparticipant {
        bigint id PK "Round 참가 이력 ID"
        bigint user_id FK "accounts_user.id"
        bigint round_id FK
        varchar student_number_snapshot
        varchar display_name_snapshot
    }
    teams_team {
        bigint id PK
        bigint round_id FK
        int team_number
        varchar name
    }
    teams_teammembership {
        bigint id PK
        bigint team_id FK
        bigint participant_id FK
    }

    %% ==========================================================
    %% 1조 - 학습 게이미피케이션
    %% User는 accounts_user.id 기준
    %% 학습 출석은 4조 실제 근태와 분리
    %% ==========================================================
    accounts_user ||--|| CG_USERS : extends
    accounts_user ||--o{ ATTENDANCES : learning_attendance
    accounts_user ||--o{ TASK_ATTEMPTS : attempts
    accounts_user ||--o{ USER_PROFICIENCY : has
    accounts_user ||--o{ ROOMS : hosts
    accounts_user ||--o{ ROOM_PARTICIPANTS : joins
    accounts_user ||--o{ RANKING_PARTICIPANTS : joins
    accounts_user ||--o{ RANK_CHALLENGES : attempts
    accounts_user ||--o{ INVENTORIES : owns
    accounts_user ||--o{ USER_CATS : adopts
    teams_team ||--o{ ROOM_PARTICIPANTS : team_participation
    CONCEPTS ||--o{ TASKS : categorizes
    CONCEPTS ||--o{ USER_PROFICIENCY : measures
    TASKS ||--o{ TASK_ATTEMPTS : receives
    ROOMS ||--o{ ROOM_PARTICIPANTS : contains
    TASKS ||--o{ ROOM_TASKS : selected
    ROOMS ||--o{ ROOM_TASKS : assigns
    RANKING_GROUPS ||--o{ RANKING_PARTICIPANTS : contains
    RANK_CHALLENGES ||--o{ RANK_CHALLENGE_TASKS : contains
    TASKS ||--o{ RANK_CHALLENGE_TASKS : included
    ITEMS ||--o{ INVENTORIES : stored
    CATS ||--o{ USER_CATS : type
    USER_CATS ||--o{ CAT_MEMORIES : remembers

    CG_USERS {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        string username
        int balance
        int mileage
        int house_level
        datetime created_at
    }
    ATTENDANCES {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        date check_in_date UK
        int streak_count
    }
    CONCEPTS {
        int id PK
        string name
        string description
    }
    TASKS {
        uuid id PK
        int concept_id FK
        string type
        string difficulty
        text template_code
        text test_cases
        boolean is_active
    }
    USER_PROFICIENCY {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        int concept_id FK
        int proficiency_level
        datetime updated_at
    }
    TASK_ATTEMPTS {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        uuid task_id FK
        text submitted_code
        string status
        boolean is_correct
        datetime attempted_at
    }
    ROOMS {
        uuid id PK
        bigint host_user_id FK "accounts_user.id"
        string title
        string status
        int max_participants
        datetime created_at
    }
    ROOM_PARTICIPANTS {
        uuid id PK
        uuid room_id FK
        bigint user_id FK "accounts_user.id"
        bigint team_id FK
        int current_score
        boolean is_ready
        datetime joined_at
    }
    ROOM_TASKS {
        uuid id PK
        uuid room_id FK
        uuid task_id FK
        int task_order
    }
    RANKING_GROUPS {
        uuid id PK
        string name
        bigint owner_user_id FK "accounts_user.id"
    }
    RANKING_PARTICIPANTS {
        uuid id PK
        uuid group_id FK
        bigint user_id FK "accounts_user.id"
        int current_rank_score
    }
    RANK_CHALLENGES {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        uuid group_id FK
        string status
        datetime started_at
        datetime expires_at
    }
    RANK_CHALLENGE_TASKS {
        uuid id PK
        uuid challenge_id FK
        uuid task_id FK
        boolean is_passed
        int task_order
    }
    ITEMS {
        int id PK
        string category
        string name
        int price
        string image_url
    }
    INVENTORIES {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        int item_id FK
        int quantity
    }
    CATS {
        int id PK
        string name
        string persona
        string rarity
    }
    USER_CATS {
        uuid id PK
        bigint user_id FK "accounts_user.id"
        int cat_id FK
        int level
    }
    CAT_MEMORIES {
        uuid id PK
        uuid user_cat_id FK
        text context_summary
        datetime created_at
    }

    %% ==========================================================
    %% 2조 - 강의/과제/평가
    %% User 관련 FK는 accounts_user.id 기준
    %% ==========================================================
    LECTURE ||--o{ LESSON : contains
    LESSON ||--o{ LESSON_MATERIAL : materials
    accounts_user ||--o{ ASSIGNMENT : creates
    accounts_user ||--o{ SUBMISSION : submits
    accounts_user ||--o{ TODO : owns
    teams_team ||--o{ SUBMISSION : team_submission
    ASSIGNMENT ||--o{ SUBMISSION : receives
    SUBMISSION ||--o{ SUBMISSION_FILE : attaches
    SUBMISSION ||--o| AI_EVALUATION : AI_evaluates
    SUBMISSION ||--o| EVALUATION : tutor_evaluates

    LECTURE {
        int id PK
        string title
        datetime created_at
    }
    LESSON {
        int id PK
        int lecture_id FK
        string title
        date lesson_date
        string blog_link
        string video_url
        datetime created_at
    }
    LESSON_MATERIAL {
        int id PK
        int lesson_id FK
        string kind
        string file_url
        string link_url
        string title
    }
    ASSIGNMENT {
        int id PK
        string title
        string description
        datetime due_at
        boolean is_required
        boolean allow_late
        boolean is_team
        bigint created_by FK "accounts_user.id"
        datetime created_at
        datetime updated_at
        datetime deleted_at
    }
    SUBMISSION {
        int id PK
        int assignment_id FK
        bigint student_id FK "accounts_user.id"
        bigint team_id FK
        string description
        datetime submitted_at
        boolean is_locked
        int final_score
    }
    SUBMISSION_FILE {
        int id PK
        int submission_id FK
        string kind
        string file_url
        string file_name
        int file_size
    }
    AI_EVALUATION {
        int id PK
        int submission_id FK UK
        int score
        string comment
        datetime updated_at
    }
    EVALUATION {
        int id PK
        int submission_id FK UK
        int score
        string feedback
        datetime created_at
        datetime updated_at
    }
    TODO {
        int id PK
        bigint student_id FK "accounts_user.id"
        string content
        boolean is_done
        datetime created_at
    }

    %% ==========================================================
