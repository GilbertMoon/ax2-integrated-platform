DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 메일 본문 링크의 기준 주소. 비우면 DJANGO_CSRF_TRUSTED_ORIGINS의 첫 항목을 쓴다.
DJANGO_SITE_URL=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HTTPS_READY=False
DJANGO_HSTS_SECONDS=0
# 프로필 사진 등 업로드 파일 저장 경로. 비우면 프로젝트 폴더의 media/를 쓴다.
# 운영 환경에서는 배포마다 지워지지 않는 영구 볼륨 경로를 지정한다.
DJANGO_MEDIA_ROOT=

POSTGRES_DB=ax_evaluation
POSTGRES_USER=ax_evaluation
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

GOOGLE_OAUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_ENABLED=False
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
SOCIALACCOUNT_REQUESTS_TIMEOUT=5

DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_TRUSTED_PROXY_HOPS=0

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Full LMS integration: enable writes only for the intended LMS database.
LMS_DATABASE_WRITE_ENABLED=False
LMS_MEDIA_ROOT=
AX_ROUND_ID=
# 2조 LMS Gemini 채점 설정
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# 3조 Idea Developer Gemini 설정 (2조 키와 독립적으로 관리)
PRD_GEMINI_API_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN_ENC_KEY=
GITHUB_SUBMISSION_REPO_NAME=lms-assignments
GITHUB_API_TOKEN=
# OAuth 콜백(redirect_uri) 고정용. 비우면 접속한 호스트 기준으로 자동 계산.
# 값을 넣을 땐 GitHub OAuth App의 Authorization callback URL과 정확히 일치해야 한다.
GITHUB_OAUTH_REDIRECT_URI=
# 제출·평가 저장 시 GitHub push/이슈 생성을 요청 안에서 동기 실행할지. 기본 False(백그라운드 스레드).
GITHUB_SYNC_SYNC=False

# 2조 LMS 과제 점수 조회용 DB (assignment_lms). 읽기 전용으로 접속한다.
LMS_DB_NAME=assignment_lms
LMS_DB_USER=postgres
LMS_DB_PASSWORD=
LMS_DB_HOST=127.0.0.1
LMS_DB_PORT=5432

# 얼굴인식 출석 키오스크가 호출하는 임베딩/라이브니스 서비스. 비우면 로컬 기본값을 쓴다.
DJANGO_FACE_SERVICE_URL=http://127.0.0.1:5001
DJANGO_FACE_SERVICE_TIMEOUT=15
